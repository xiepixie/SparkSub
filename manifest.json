{
  "manifest_version": 3,
  "name": "SparkSub - 视频字幕助手 (Sparkle Sub)",
  "version": "0.2.0",
  "description": "SparkSub: 为 YouTube 和哔哩哔哩提供播放器旁实时滚动字幕、Chrome 独立侧边栏、合集批量导出与 AI 总结工作流。",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "webRequest",
    "declarativeNetRequest",
    "sidePanel",
    "scripting",
    "downloads",
    "offscreen",
    "contextMenus",
    "nativeMessaging",
    "cookies"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://*.bilibili.com/*",
    "http://*.bilibili.com/*",
    "https://*.biliapi.net/*",
    "http://*.biliapi.net/*",
    "https://*.biliapi.com/*",
    "http://*.biliapi.com/*",
    "https://*.hdslb.com/*",
    "http://*.hdslb.com/*",
    "https://*.hdslb.net/*",
    "http://*.hdslb.net/*",
    "https://*.bilivideo.com/*",
    "http://*.bilivideo.com/*",
    "https://*.bilivideo.cn/*",
    "http://*.bilivideo.cn/*",
    "https://*.szbdyd.com/*",
    "http://*.szbdyd.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "打开字幕侧边栏",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content/main-world-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://*.youtube.com/*",
        "*://*.bilibili.com/*",
        "*://www.bilibili.com/*",
        "*://search.bilibili.com/*",
        "*://space.bilibili.com/*",
        "*://t.bilibili.com/*",
        "*://live.bilibili.com/*"
      ],
      "js": [
        "core/namespace.js",
        "core/diagnostics.js",
        "core/utils.js",
        "core/jszip.js",
        "core/i18n.js",
        "core/parsers.js",
        "core/media.js",
        "core/formatters.js",
        "core/asr-polisher.js",
        "core/tracker.js",
        "core/queue.js",
        "platform/youtube.js",
        "platform/bilibili.js",
        "content/rolling-panel.js",
        "content/feed-injector.js",
        "content/app.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
