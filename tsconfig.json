{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "types/**/*.d.ts",
    "core/**/*.js",
    "platform/**/*.js",
    "content/**/*.js",
    "background/**/*.js",
    "sidepanel/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "tests"
  ]
}
